{
  "name": "perfherder2",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "perfherder-cli": "bin/perfherder-cli"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "verify:cli": "node scripts/verify-cli-build.mjs",
    "publish:cli": "node scripts/publish-cli.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.cli.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  }
}
